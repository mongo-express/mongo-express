# Copy to .env and adjust. Every variable below is read by config.default.js; the full list
# is documented in the README.

# --- MongoDB ------------------------------------------------------------------------------

# Connection string. Include credentials and authSource=admin when using the root user
# created by the official MongoDB image:
#   mongodb://root:password@mongo:27017/?authSource=admin
ME_CONFIG_MONGODB_URL=mongodb://localhost:27017

# Show every database and the server statistics, rather than only the one in the URL.
ME_CONFIG_MONGODB_ENABLE_ADMIN=false

# --- Web interface ------------------------------------------------------------------------

# Signs the session cookie. Set your own value; do not ship this example as-is.
ME_CONFIG_SITE_SESSIONSECRET=change-me

# Where the app is served from. Keep the leading and trailing slash.
ME_CONFIG_SITE_BASEURL=/

# Health check path. Served before authentication, so probes do not need credentials.
ME_CONFIG_HEALTH_CHECK_PATH=/status

# --- Basic authentication -------------------------------------------------------------------

# Gates the web interface only. These are not used to authenticate against MongoDB, which
# takes its credentials from ME_CONFIG_MONGODB_URL.
ME_CONFIG_BASICAUTH_ENABLED=false
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=

# --- Restrictions ---------------------------------------------------------------------------

# Refuse every write, server-side.
ME_CONFIG_OPTIONS_READONLY=false

# Refuse deletions only.
ME_CONFIG_OPTIONS_NO_DELETE=false
